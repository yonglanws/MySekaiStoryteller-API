# =============================================================================
# MySekaiStoryteller-API — Public Docker & Environment Template
# =============================================================================
# Quick start:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in MSS_LLM_API_KEY (and MSS_LLM_BASE_URL / MSS_LLM_MODEL if needed)
#   3. Start container: docker compose up -d --build
#
# No config.yaml is required! All settings below work out-of-the-box via env.
# Priority: MSS_* env vars > config.yaml > built-in defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Docker Build & Host Binding
# -----------------------------------------------------------------------------
# Build mirror: "global" (default) or "cn" (uses rsproxy.cn + npmmirror.com)
BUILD_MIRROR=global
# Host port mapped to container port 9881
MSS_HOST_PORT=9881
# Container timezone (e.g. UTC, Asia/Shanghai, Asia/Tokyo)
TZ=UTC
# Intel overlay (/dev/dri) group overrides (check host: getent group video render)
# VIDEO_GID=video
# RENDER_GID=render

# -----------------------------------------------------------------------------
# 2. AI Script Generation (OpenAI-Compatible Chat Completions)
# -----------------------------------------------------------------------------
MSS_LLM_ENABLED=true
# API base URL without trailing /chat/completions (supports OpenAI, Ollama, vLLM, etc.)
MSS_LLM_BASE_URL=https://api.openai.com/v1
# Required when MSS_LLM_ENABLED=true (never commit your real .env to git!)
MSS_LLM_API_KEY=
MSS_LLM_MODEL=gpt-4.1-mini
# Pipeline: hybrid (tool-driven 3-stage) | staged | agent | single
MSS_LLM_PIPELINE=hybrid
# Target video length in minutes (soft prompt hint)
MSS_LLM_TARGET_MINUTES=3
# Translate Chinese dialogue to Japanese ttsText for Japanese TTS engines
MSS_LLM_TRANSLATE=true
# Optional: comma-separated persona markdown directories (mount ./personas:/app/personas:ro)
# MSS_LLM_PERSONA_DIRS=/app/personas
# MSS_LLM_POLISH_DIALOGUE=true

# -----------------------------------------------------------------------------
# 3. GPU & Hardware Acceleration
# -----------------------------------------------------------------------------
# Preset: auto | intel | nvidia | amd | cpu
# Tip: docker-compose.intel.yml sets intel; docker-compose.nvidia.yml sets nvidia.
# MSS_GPU_PROFILE is also supported and takes precedence over MSS_GPU_MODE if both are set.
MSS_GPU_MODE=auto
# MSS_GPU_PROFILE=auto
# Explicit overrides (uncomment only if you want to override the GPU preset):
# MSS_FFMPEG_ENCODER=auto
# MSS_VIDEO_ENCODER=auto
# MSS_LINUX_GPU_ANGLE=true
# MSS_CHROME_ARGS=

# -----------------------------------------------------------------------------
# 4. Video Output & Encoding
# -----------------------------------------------------------------------------
MSS_VIDEO_WIDTH=1920
MSS_VIDEO_HEIGHT=1080
MSS_VIDEO_FPS=60
MSS_FAST_FPS=60
MSS_VIDEO_RENDER_SCALE=1
# Codec: hevc (smaller files, hardware QSV/NVENC friendly) | h264
MSS_VIDEO_CODEC=hevc
MSS_VIDEO_CRF=27
MSS_EXPORT_BITRATE=5500000
MSS_MAX_OUTPUT_MBPS=6.5
MSS_USE_RUST_EXPORTER=true
MSS_EXPORT_JOBS=1
# Watermark settings
MSS_VIDEO_WATERMARK=true
# MSS_VIDEO_WATERMARK_TEXT=

# -----------------------------------------------------------------------------
# 5. Memory & Render Worker Preset
# -----------------------------------------------------------------------------
# Preset: standard (default) | low (for 4-8GB RAM hosts/NAS:
#   workers=1, maxConcurrentExports=1, workerRecycleExports=2, fps=30, fastFps=30, renderScale=1.0)
# Note: when using MSS_MEMORY_PROFILE=low, comment out MSS_VIDEO_FPS / MSS_FAST_FPS
# above (or set them to 30) so the low-memory preset takes full effect.
MSS_MEMORY_PROFILE=standard
# Explicit worker overrides (uncomment to override the preset):
# MSS_WORKERS=2
# MSS_MAX_CONCURRENT_EXPORTS=0
# MSS_WORKER_RECYCLE_EXPORTS=5
# MSS_MIN_FREE_MEMORY_MB=0
# glibc low-fragmentation memory defaults (already set in Dockerfile & docker-compose.yml):
# MALLOC_ARENA_MAX=2
# MALLOC_MMAP_THRESHOLD_=131072

# -----------------------------------------------------------------------------
# 6. Cloud Assets & Background Music (BGM)
# -----------------------------------------------------------------------------
# Zero local assets needed: Live2D models, backgrounds, BGM, and SE load on demand.
MSS_ASSETS_CLOUD_CATALOG=true
MSS_ASSETS_CLOUD_ONLY=true
# Asset region: jp | cn | tw | kr | en
MSS_ASSETS_REGION=jp
# Global default BGM (0.35 leaves clean headroom for speech ducking)
MSS_BGM_ENABLED=true
MSS_BGM_PATH=bgm00003
MSS_BGM_VOLUME=0.35

# -----------------------------------------------------------------------------
# 7. Optional — TTS Voice Synthesis (GPT-SoVITS / IrodoriTTS)
# -----------------------------------------------------------------------------
# Disabled by default so first deployment works immediately without a TTS server.
MSS_TTS_ENABLED=false
# MSS_TTS_PROVIDER=irodori
# MSS_TTS_API_BASE_URL=http://host.docker.internal:8088
# MSS_TTS_TIMEOUT_MS=120000
# MSS_TTS_MODE=concurrent

# -----------------------------------------------------------------------------
# 8. Optional — Semantic RAG (Official Story Retrieval)
# -----------------------------------------------------------------------------
# Uses MSS_LLM_BASE_URL + MSS_LLM_API_KEY by default; falls back to lexical search offline.
# MSS_RAG_ENABLED=true
# MSS_RAG_BASE_URL=
# MSS_RAG_MODEL=qwen3-embedding-8b
# MSS_RAG_RERANK_ENABLED=true
# MSS_RAG_RERANK_MODEL=qwen3-reranker-8b

# -----------------------------------------------------------------------------
# 9. Optional — Outbound Network Proxy
# -----------------------------------------------------------------------------
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# NO_PROXY=localhost,127.0.0.1

# -----------------------------------------------------------------------------
# 10. Optional — API Authentication, CORS & Logging
# -----------------------------------------------------------------------------
# Strongly recommended when exposing port 9881 outside localhost:
# MSS_API_KEY=
# MSS_SERVER_CORS=false
# MSS_CORS_ORIGINS=https://example.com
MSS_LOG_LEVEL=info
